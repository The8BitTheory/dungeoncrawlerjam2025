#RetroDevStudio.MetaData.BASIC:7169,BASIC V7.0 VDC,uppercase,10,10

# LOADS THE WALLSETFILE FROM DISK AND DISPLAYS IT ON THE SCREEN

5 DEF FN PA(ZZ)=7*ZZ+1
6 DEF FN LB(ZZ)=DEC(RIGHT$(HEX$(ZZ),2))
7 DEF FN HB(ZZ)=DEC(LEFT$(HEX$(ZZ),2))

10 GRAPHIC0:BANK0
20 DD=PEEK(186)
30 BE=PEEK(4624)+PEEK(4625)*256
40 REM BLOAD"VDCBASIC2F.1300",B0,U(DD)
41 SYSDEC("1300")
50 AP=16000

60 RGW0,127:RGW4,155:RGW6,100:RGW7,140:RGW9,1
70 RGO25,128:REM BITMAP MODE ON
80 RGO28,24:REM 64K VRAM
90 RGW36,0
100 RGW DEC("1A"),DEC("FF")

110 VMF0,15,AP:REM SETUP PIXELS
120 VMFAP,0,8000:REM CLEAR ATTRIBUTE RAM
130 DISP0:ATTRAP:DA=AP+8000:OS=0

140 DIM DM(18,4)

150 FI$="WALLS.VDC"
160 ?"LOADING "FI$"...";:BLOAD (FI$),B0,P(BE):? "DONE"

170 FL=PEEK(174)+PEEK(175)*256-BE:?"LENGTH:"FL

175 DC=PEEK(BE):PRINT DC " ENTRIES"
176 D=FNPA(DC):DB=BE+FL:CL=DB
177 FL=FL-D
180 ?"RTV TO "DA:FAST

190 RTV BE+D,DA,FL

195 FOR FI=0 TO DC-1

196  PA=BE+FNPA(FI)

#    VMC WITH 5 PARAMETERS
200  POKE DB,2

#    SOURCE
210  V=PEEK(PA)+PEEK(PA+1)*256+DA
215  POKE DB+1,FNLB(V):POKE DB+2,FNHB(V)

#    TARGET
220  V=PEEK(PA+6)+AP
225  POKE DB+3,FNLB(V):POKEDB+4,FNHB(V)

#    WIDTH
230  V=PEEK(PA+2)
235  POKE DB+5,V:POKE DB+6,0

#    HEIGHT
240  V=PEEK(PA+3)
245  POKE DB+7,V:POKE DB+8,0

#    TARGET ADDRESS INCREASE
250  POKE DB+9,80:POKE DB+10,0

260  DB=DB+11

270 NEXT

272 POKE DB-10,0

275 SLOW
277 PRINT "BEGIN:"HEX$(CL)
278 PRINT "END:"HEX$(DB-10)
279 PRINT "KEY TO CONTINUE":GETKEY I$

280 VCL CL

340 GOTO 280
350 SLOW
360 BANK15
