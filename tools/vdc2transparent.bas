#RetroDevStudio.MetaData.BASIC:7169,BASIC V7.0 VDC,uppercase,10,10
# TRANSFORMS BITMAP INTO VDC-FILE WITH TRANSPARENCY
# THE TRANSPARENCY IS JUST A RESULT OF COMPLEX METADATA THAT
#  TELLS VDC-BASIC WHICH BYTES TO LEAVE OUT

# 4.64 MINUTES WRITING TO VRAM
# 4.16 MINUTES POKING AND THEN WRITING TO VRAM

10 GRAPHIC 0
# DEFINE FUNCTIONS
20 GOSUB 920
30 BS=FN W(45)
40 BE=FN W(4624)
# DB=DATA BEGIN
# DE=DATA END
50 DB=BE:DE=DB+8000

60 PRINT "BASIC FROM "BS" TO "BE"."
70 PRINT "LEAVES "FRE(0)" BYTES FREE."
80 DD=PEEK(186)

90 PRINT "INSERT DATADISK":GETKEY I$

99 REM BLOAD "VDCBASIC2F.1300",B0,U(DD)
100 SYS DEC("1300")

110 AP=8000:DISP 16000

# 2 SCANLINES PER CHAR, 160 SCANLINES (EACH VAL +1)
120 RGW 0,127:RGW 4,155:RGW 6,100:RGW 7,140:RGW 9,1
130 RGO 25,128:REM BITMAP MODE ON
140 RGO 28,24:REM 64K VRAM
150 RGW 36,0
160 RGW DEC("1A"),DEC("FF")

170 VMF 16000,15,16000:REM SETUP PIXELS
180 VMF 0,0,16000: REM CLEAR ATTRIBUTE RAM
190 ATTR 0:BANK 0


200 FOR FI=0TO3
210  PF$="RED0"+MID$(STR$(FI),2)+"A.VDC"
220  GOSUB 250
225  IF FI<3 THEN PRINT "PRESS KEY FOR NEXT IMAGE":GETKEY I$
230 NEXT
240 BANK15:END


250 PRINT "LOADING "PF$" ... ";

300 BLOAD (PF$),B0,P(DB),U(DD)
310 FL=PEEK(174)+PEEK(175)*256-BE:?"DONE. LENGTH:"FL
315 PO=BE+FL:SP=PO
316 PRINT "START PO="PO", $"HEX$(PO)

#   LEAVE FIRST POKE ADDRESS FREE, TO WRITE THE VALUE OF CC AT THE END
319 PO=PO+1
320 GOSUB 360
325 PRINT "END PO="PO", $"HEX$(PO)

340 SLOW


350 RETURN

# WE'RE PROCESSING THE INPUT FILE IN CPU-RAM
# ONCE A LINE IS DONE, WE EXECUTE RTV AS WE WOULD VMC

360 BW=PEEK(DB)+1:BH=PEEK(DB+1):ID=DB+2:PRINT"IMAGE DATA STARTS AT "ID
#370 PRINT "ID BEFORE:"(ID+BW*BH)
#370 RTV DB+2,AP+8000,BW*BH

380 RO=0:WO=0:RC=0:CC=0:RT=AP

400 FOR Y=0 TO BH-1
405  WO=Y*80
410  FOR X=0 TO BW-1
#415   PRINT "LINE "Y": RO="RO",WO="WO",RC="RC
420   C$=RIGHT$(HEX$(PEEK(ID)),2)

430   IF C$="77" THEN BEGIN
440    WO=WO+1

#                   ADD VMC COMMAND
450    IF RC>0 THEN GOSUB 500
460   BEND:GOTO 470

465   RC=RC+1:RO=RO+1:WO=WO+1

470  ID=ID+1:NEXT

475  WO=WO+1:IF RC>0 THEN GOSUB 500

480 NEXT

485 POKE PO,0:PO=PO+1
486 POKE SP,CC

488 REM VMS 8000,40,SP

490 RETURN

500 RS=ID-RC:RT=RT+VC
501 GOSUB 1000
502 PRINT "RTV"RS","RT","VC
#504 PRINT " VMC"RT","VT","VC
506 RC=0
508 RTV RS,RT,VC
510 VMC RT,VT,VC
#512 GETKEYI$
514 RETURN

880 POKE DB+IS,BW:POKE DB+IS+1,BH

890 WF$="@"+LEFT$(PF$,LEN(PF$)-4)+".VDC"
900 BSAVE (WF$),B0,U(DD),P(DB+IS) TO P(DB+IS+FL+PO)

910 RETURN

920 DEF FN W(ZZ)=PEEK(ZZ)+PEEK(ZZ+1)*256
930 DEF FN W4(ZZ)=PEEK(ZZ)+PEEK(ZZ+1)*256+PEEK(ZZ+2)*65536+PEEK(ZZ+3)*16777216
940 DEF FN V(ZZ)=DEC(RIGHT$(HEX$(ZZ),1))
950 DEF FN HN(ZZ)=DEC(MID$(HEX$(ZZ),3,1))
960 DEF FN LN(ZZ)=DEC(RIGHT$(HEX$(ZZ),1))
970 DEF FN LB(ZZ)=DEC(RIGHT$(HEX$(ZZ),2))
980 DEF FN HB(ZZ)=DEC(LEFT$(HEX$(ZZ),2))

990 RETURN

# WRITE VMC DATA
1000 VS=RO-RC
1010 VT=WO-RC-1
1020 VC=RC

1030 BANK 0

#1035 PRINT " ADD VMS("HEX$(VT)","HEX$(VC)")"

#    WRITE VCL COMMAND-BYTE 2 (VMS WITH 3 PARAMETERS)
#1040 POKE PO,12:PO=PO+1
#1050 POKE PO,FNLB(VS):PO=PO+1
#1060 POKE PO,FNHB(VS):PO=PO+1
1070 POKE PO,FNLB(VT):PO=PO+1
1080 POKE PO,FNHB(VT):PO=PO+1
1090 POKE PO,FNLB(VC):PO=PO+1
1100 POKE PO,FNHB(VC):PO=PO+1
#1110 POKE PO,0:PO=PO+1

#1110 VMC VS,VT,VC

1120 CC=CC+1
1130 RETURN