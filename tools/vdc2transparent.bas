#RetroDevStudio.MetaData.BASIC:7169,BASIC V7.0 VDC,uppercase,10,10
# TRANSFORMS BITMAP INTO VDC-FILE WITH TRANSPARENCY
# THE TRANSPARENCY IS JUST A RESULT OF COMPLEX METADATA THAT
#  TELLS VDC-BASIC WHICH BYTES TO LEAVE OUT

# 4.64 MINUTES WRITING TO VRAM
# 4.16 MINUTES POKING AND THEN WRITING TO VRAM

10 GRAPHIC 0
# DEFINE FUNCTIONS
20 GOSUB 920
30 BS=FN W(45)
40 BE=FN W(4624)
# DB=DATA BEGIN
# DE=DATA END
50 DB=BE+1:DE=DB+8000

60 PRINT "BASIC FROM "BS" TO "BE"."
70 PRINT "LEAVES "FRE(0)" BYTES FREE."
80 DD=PEEK(186)

90 PRINT "INSERT DATADISK":GETKEY I$

100 BLOAD "VDCBASIC2F.1300",B0,U(DD):SYS DEC("1300")

110 AP=0:DISP 16000

# 2 SCANLINES PER CHAR, 160 SCANLINES (EACH VAL +1)
120 RGW 0,127:RGW 4,155:RGW 6,100:RGW 7,140:RGW 9,1
130 RGO 25,128:REM BITMAP MODE ON
140 RGO 28,24:REM 64K VRAM
150 RGW 36,0
160 RGW DEC("1A"),DEC("FF")

170 VMF 16000,15,16000:REM SETUP PIXELS
180 VMF AP,0,16000: REM CLEAR ATTRIBUTE RAM
190 ATTR AP:BANK 0


200 FOR FI=0TO3
210  PF$="RED0"+MID$(STR$(FI),2)+"A.VDC"
220  GOSUB 250
230 NEXT
240 BANK15:END


250 PRINT "LOADING "PF$" ... ";

300 BLOAD (PF$),B0,P(DB),U(DD)
310 PRINT "DONE"
320 GOSUB 360

340 SLOW


350 RETURN

# WE'RE PROCESSING THE INPUT FILE IN CPU-RAM
# ONCE A LINE IS DONE, WE EXECUTE RTV AS WE WOULD VMC

360 BW=PEEK(DB)+1:BH=PEEK(DB+1):ID=DB+2:PRINT"IMAGE DATA STARTS AT "ID
#370 RTV DB+2,AP+8000,BW*BH

380 RO=0:WO=0:RC=0:PO=ID+BW*BH

400 FOR Y=0 TO BH
405  WO=Y*80
410  FOR X=0 TO BW-1
415   PRINT "LINE "Y": RO="RO",WO="WO",RC="RC
420   C$=RIGHT$(HEX$(PEEK(ID)),2)
421   PRINT C$;

430   IF C$="77" THEN BEGIN
440    WO=WO+1

445    

#                   ADD VMC COMMAND
450    IF RC>0 THEN GOSUB 500
460   BEND:GOTO 470

465   RC=RC+1:RO=RO+1:WO=WO+1

470  ID=ID+1:NEXT

475  IF RC>0 THEN WO=WO+1:GOSUB 500
476  GETKEYI$

477  PRINT

479 NEXT

480 END
490 RETURN

500 RS=ID-RC:RT=AP+VS+8000
501 GOSUB 1000
502 PRINT "RTV"RS","RT","VC
504 PRINT " VMC"RT","VT","VC
506 RC=0
508 RTV RS,RT,VC
510 VMC RT,VT,VC
#512 GETKEYI$
514 RETURN




#380 VMC AP+8000,AP,BW,BH,80
#390 RETURN


# IMAGEDATA
560 BANK0
570 ID=DB

#   POKE-OFFSET. USED FOR POKING VDC-METADATA. STARTS WITH 2
#   CC:COMMAND-COUNT. HOW MANY VCL-COMMANDS DID WE CREATE
610 PO=2:CC=0

#   RO:READ OFFSET (WHERE TO READ THE NEXT BMP INPUT BYTE FROM)
#   WO:WRITE OFFSET (WHERE TO WRITE THE NEXT VDC OUTPUT BYTE TO)
#   RC=READ COUNT

# 1000: ADD PIXEL
# 1100: COMPRESS
# BYTE OPERATIONS:
# C: BLOCK COPY
# W: WRITE SINGLE BYTE VALUE
# O: WRITE OR-ED BYTE VALUE
# A: WRITE AND-ED BYTE VALUE
# F: BLOCK FILL
620 S=TI:
630 FOR Y=0 TO BH
640  WO=Y*BW*80
650  FOR X=0 TO BW

660   C$=RIGHT$(HEX$(PEEK(ID)),2)
670   ID=ID+1

730   C1$=LEFT$(C$,1):C2$=RIGHT$(C$,1)

#     WRITE TWO PIXELS TO VRAM
740   VMW VP,DEC(C1$+C2$):VP=VP+1

750  NEXT

760  IF P2-BW>0 THEN ID=ID+(P2-BW)-1

770  IF Y>0 THEN VP=VP-BW-BW-2

780 NEXT:S=TI-S:SLOW:PRINT "TOOK "S" JIFFIES"

790 PRINT C$:GETKEY I$

#   COPY FROM VRAM TO RAM
800 FL=(BW+1)*BH
810 VTR VP,DB+IS+PO,FL

#   COPY FROM INVISIBLE TO VISIBLE VRAM (FOR VISUAL VALIDATION)
820 VMC VP,AP,BW+1,BH,80,BW+1



#680   IF C$="77" THEN BEGIN
#690    WO=WO+1
#                   ADD VMC COMMAND
#700    IF RC>0 THEN GOSUB 1000:RC=0
#710   BEND:GOTO 730

#     ELSE, JUST INCREASE COUNTERS
#720   RC=RC+1:RO=RO+1:WO=WO+1:GOTO 750

#820 FOR PO=0 TO CC*8 STEP 8
#830  VS = PEEK(DB+IS+PO+1)+PEEK(DB+IS+PO+2)*256
#840  VT = PEEK(DB+IS+PO+3)+PEEK(DB+IS+PO+4)*256
#850  VC = PEEK(DB+IS+PO+5)+PEEK(DB+IS+PO+6)*256

#860  VMC VS,VT,VC

#870 NEXT




880 POKE DB+IS,BW:POKE DB+IS+1,BH

890 WF$="@"+LEFT$(PF$,LEN(PF$)-4)+".VDC"
900 BSAVE (WF$),B0,U(DD),P(DB+IS) TO P(DB+IS+FL+PO)

910 RETURN

920 DEF FN W(ZZ)=PEEK(ZZ)+PEEK(ZZ+1)*256
930 DEF FN W4(ZZ)=PEEK(ZZ)+PEEK(ZZ+1)*256+PEEK(ZZ+2)*65536+PEEK(ZZ+3)*16777216
940 DEF FN V(ZZ)=DEC(RIGHT$(HEX$(ZZ),1))
950 DEF FN HN(ZZ)=DEC(MID$(HEX$(ZZ),3,1))
960 DEF FN LN(ZZ)=DEC(RIGHT$(HEX$(ZZ),1))
970 DEF FN LB(ZZ)=DEC(MID$(HEX$(ZZ),3,1))
980 DEF FN HB(ZZ)=DEC(RIGHT$(HEX$(ZZ),1))

990 RETURN

# WRITE VMC DATA
1000 VS=RO-RC
1010 VT=WO-RC-1
1020 VC=RC

1030 PRINT " ADD VMC("VS","VT","VC")"

#    WRITE VCL COMMAND-BYTE 1 (VMC WITH 3 PARAMETERS)
1040 POKE PO,1:PO=PO+1
1050 POKE PO,FNLB(VS):PO=PO+1
1060 POKE PO,FNHB(VS):PO=PO+1
1070 POKE PO,FNLB(VT):PO=PO+1
1080 POKE PO,FNHB(VT):PO=PO+1
1090 POKE PO,FNLB(VC):PO=PO+1
1100 POKE PO,FNHB(VC):PO=PO+1
1110 POKE PO,0:PO=PO+1

1120 CC=CC+1
1130 RETURN